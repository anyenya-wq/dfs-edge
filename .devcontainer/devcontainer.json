{
  "name": "DFS Edge",

  // For after this project moves to its own repository, where app.py
  // sits at the root. Until then the copy at
  // ../.devcontainer/dfs-edge/devcontainer.json is the one Codespaces
  // reads, because it only looks under the repository root.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && (python3 -m dfs.cli load-history --sport NFL && python3 -m dfs.cli load-history --sport NBA || echo '⚠️  History download failed; the app will retry on first use') && echo '✅ DFS Edge ready'",

  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },

  "portsAttributes": {
    "8501": {
      "label": "DFS Edge",
      "onAutoForward": "openPreview"
    }
  },

  "forwardPorts": [8501]
}
